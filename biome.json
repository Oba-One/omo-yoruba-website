{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/.astro",
      "!**/.vercel",
      "!docs/design",
      "!**/sanity.types.ts",
      "!packages/tokens/src/patterns",
      "!scripts/baseline.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "groq": "GROQ belongs to @oy/content: add the query to packages/content/src/queries and import it from @oy/content.",
              "@sanity/client": "The Sanity client belongs to @oy/content and the web loaders (packages/web/src/lib/sanity, lib/forms/site-deps.ts, pages/api/preview): load data through them.",
              "sanity:client": "The Sanity client belongs to the web loaders (packages/web/src/lib/sanity): load data through them."
            },
            "patterns": [
              {
                "group": ["@sanity/client/*"],
                "message": "The Sanity client belongs to @oy/content and the web loaders (packages/web/src/lib/sanity, lib/forms/site-deps.ts, pages/api/preview): load data through them."
              }
            ]
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/tokens/src/**/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          },
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/content/**",
        "packages/web/src/lib/sanity/**",
        "packages/web/src/lib/forms/site-deps.ts",
        "packages/web/src/pages/api/preview/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
