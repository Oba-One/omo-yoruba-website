# Copy to apps/web/.env for local work, or run `bash scripts/setup-wizard.sh` from the
# repo root, which writes this file and the matching Vercel environment variables.
# Names and roles: docs/design/README.md section 7. All optional until Phase 2. Vercel holds
# the deployed values per environment (the wizard sets them); this file is local only.

# Client, public
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
PUBLIC_ZEFFY_EMBED_URL=
PUBLIC_EVENTBRITE_URL=

# Server, secret
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_PREVIEW_SECRET=
SANITY_WEBHOOK_SECRET=
