{
  "name": "@oy/content",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./studio": "./src/studio/config.ts",
    "./enquiry-kinds": "./src/enquiry-kinds.ts",
    "./enquiry-zod": "./src/enquiry-zod.ts",
    "./pending": "./src/pending.ts",
    "./routes": "./src/routes.ts",
    "./queries": "./src/queries/index.ts",
    "./images": "./src/images.ts",
    "./layout": "./src/layout.ts",
    "./lead-event": "./src/lead-event.ts",
    "./stega": "./src/stega.ts",
    "./api-version": "./src/api-version.ts",
    "./take-part": "./src/take-part.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "sanity": "bash scripts/sanity.sh",
    "typegen": "bash scripts/sanity.sh schema extract --path ./schema.json --force && bash scripts/sanity.sh typegen generate",
    "seed": "bun --env-file=../web/.env scripts/seed.ts",
    "query": "bun --env-file=../web/.env scripts/query.ts"
  },
  "dependencies": {
    "@oy/lint": "workspace:*",
    "@sanity/blueprints": "0.24.0",
    "@sanity/client": "8.5.0",
    "@sanity/functions": "1.7.1",
    "@sanity/image-url": "2.1.1",
    "@sanity/vision": "6.12.0",
    "groq": "6.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.26.0",
    "sanity": "6.12.0",
    "styled-components": "6.5.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
}
