---
/**
 * A Studio action as a button: the `cta` object's kind decides the trigger (an enquiry kind opens
 * the Enquiry Modal, `give` the Give Dialog, a link or an anchor is a plain href) and the label
 * is the content. A half-filled action renders nothing: the Studio's validation keeps one from
 * being published. The variant carries the gold rule: outline by default, a page passes
 * `primary` once per view.
 */
import Button, { type ButtonSize, type ButtonVariant } from '../Button/Button.astro';
import { type ActionLike, resolveAction } from './action';

interface Props {
  action?: ActionLike | null;
  variant?: ButtonVariant;
  size?: ButtonSize;
  arrow?: boolean;
  class?: string;
}

const {
  action,
  variant = 'primary',
  size = 'default',
  arrow = true,
  class: className,
} = Astro.props;
const resolved = resolveAction(action);
---

{
  resolved?.ok && (
    <Button variant={variant} size={size} arrow={arrow} class={className} {...resolved.attributes}>
      {resolved.label}
    </Button>
  )
}
