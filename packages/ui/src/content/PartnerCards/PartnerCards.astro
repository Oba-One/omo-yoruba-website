---
/**
 * The partners and sponsors of a page as cards (added after the handoff, whose `08 Odunde
 * Festival.dc.html` draws a row of name chips; ADR 0057). One card each on the card base: what the
 * partner is to us (partner, sponsor or funder) as the kicker, its name, one line on what it does with us
 * when the Studio holds one, and a quiet link to its own site, worded by the site's address. The logo
 * leads the card when the Studio holds one. Three across, two on a tablet and one on a phone, a short
 * last row in the middle. No partner renders the registry's Pending line. `PartnerRow` keeps the chips
 * for a list of names alone.
 */
import Card from '../../cards/Card/Card.astro';
import { safeHref } from '../../core/ActionButton/action';
import Button from '../../core/Button/Button.astro';
import Pending from '../../core/Pending/Pending.astro';
import { altOf, imgAttributes } from '../../media/image';
import CardGrid from '../../page/CardGrid/CardGrid.astro';
import type { PartnerLike } from '../PartnerRow/PartnerRow.astro';

export interface PartnerCardLike extends PartnerLike {
  /** What the partner is to us: `partner`, `sponsor` or `funder`, as the Studio stores it. */
  kind?: string | null;
  /** One line on what the partner does with us. */
  line?: string | null;
}

interface Props {
  partners?: (PartnerCardLike | null)[] | null;
  /** The registry's wording when there are no partners. */
  pending?: string;
  /** A `data-sanity` attribute, so click-to-edit reaches the block. */
  edit?: string;
  class?: string;
}

/** The kicker each kind wears; a kind the Studio does not know draws none. */
const KIND_LABELS: Record<string, string> = {
  partner: 'Partner',
  sponsor: 'Sponsor',
  funder: 'Funder',
};

/** A site's address as a reader says it: the host, without `www.`. */
function hostOf(href: string): string | undefined {
  try {
    return new URL(href).hostname.replace(/^www\./, '') || undefined;
  } catch {
    return undefined;
  }
}

const { partners, pending = 'partner and funder names', edit, class: className } = Astro.props;
const list = (partners ?? []).filter(
  (partner): partner is PartnerCardLike => partner !== null && Boolean(partner.name?.trim()),
);
---

{
  list.length === 0 ? (
    <div class:list={['oy-partner-cards', className]} data-sanity={edit}>
      <Pending variant="line" what={pending} />
    </div>
  ) : (
    <CardGrid columns={3} center class:list={['oy-partner-cards', className]} data-sanity={edit}>
      {list.map((partner) => {
        const logo = imgAttributes(partner.logo, '160px');
        // Checked again here: the Studio's URL rule does not run on API or seed writes.
        const url = safeHref(partner.url);
        const host = url ? hostOf(url) : undefined;
        const kind = KIND_LABELS[partner.kind?.trim() ?? ''];
        const line = partner.line?.trim();
        return (
          <Card
            class="oy-partner-card"
            kicker={kind ? { en: kind } : undefined}
            title={partner.name}
            data-kind={partner.kind?.trim() || undefined}
          >
            {logo && (
              <img
                slot="media"
                class="oy-partner-card-logo"
                {...logo}
                alt={altOf(partner.logo, '')}
                loading="lazy"
                decoding="async"
              />
            )}
            {line && <p>{partner.line}</p>}
            {url && host && (
              <Button variant="quiet" href={url} rel="noopener" arrow class="oy-partner-card-link">
                <span class="oy-visually-hidden">{partner.name}: </span>
                {host}
              </Button>
            )}
          </Card>
        );
      })}
    </CardGrid>
  )
}

<style>
  /* A logo sits on the card's ground above its words, at its own shape, never cropped. */
  :global(.oy-partner-card) > :global(.oy-partner-card-logo) {
    display: block;
    width: auto;
    max-width: 160px;
    height: 44px;
    margin: 22px 22px 0;
    object-fit: contain;
    object-position: left center;
  }
  /* The link keeps to the foot of the card, so a row of cards ends on one line. */
  :global(.oy-partner-card) :global(.oy-partner-card-link) {
    margin-top: auto;
    align-self: flex-start;
  }
  /* A partner's card is short, so a tablet keeps two across where the grid's three stack to one. */
  @media (560px <= width <= 860px) {
    :global(.oy-card-grid.oy-partner-cards[data-columns='3'][data-center]) {
      --across: 2;
    }
  }
</style>
