---
/** A reading column with task links and room for instructional screenshots. */
interface Props {
  sections: { slug: string; text: string }[];
}

const { sections } = Astro.props;
---

<main class="oy-reading-guide">
  <nav aria-label="Guide contents">
    <p><strong>In this guide</strong></p>
    <ul>
      {sections.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}
    </ul>
  </nav>
  <article aria-label="Member guide">
    <slot />
  </article>
</main>

<style>
  .oy-reading-guide {
    max-width: 900px;
    margin-inline: auto;
    padding: var(--space-4) var(--gutter);
    font-size: var(--text-body-size);
    line-height: var(--leading-body);
  }

  nav {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-soft);
  }

  nav p {
    font-family: var(--font-display);
    font-size: var(--text-h3);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }

  a,
  article :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  article :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }

  a:focus-visible,
  article :global(a:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
  }

  article :global(h1) {
    font-size: var(--text-hero);
    line-height: var(--leading-heading);
  }

  article :global(h2) {
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    font-size: var(--text-h2);
    scroll-margin-top: var(--space-3);
  }

  article :global(p),
  article :global(ol),
  article :global(ul) {
    margin-block: var(--space-2);
  }

  article :global(ol),
  article :global(ul) {
    padding-left: var(--space-3);
  }

  article :global(li) {
    margin-block: var(--space-1);
  }

  article :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin-block: var(--space-3) var(--space-1);
    border: 1px solid var(--border-soft);
  }
</style>
