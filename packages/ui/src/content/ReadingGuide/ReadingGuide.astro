---
/**
 * A step-by-step guide read beside the tool it describes: a list of tasks that stays in view on a wide
 * screen, and a reading column set for older eyes (larger type, a short measure, room between steps).
 * The slot takes rendered Markdown: numbered steps, `figure` for a screenshot with its caption, and
 * `aside` for a note that is not a step. Printed, it drops the task list and keeps each step whole.
 */
interface Props {
  sections: { slug: string; text: string }[];
}

const { sections } = Astro.props;
---

<main class="oy-reading-guide" id="top">
  <nav aria-label="Guide contents">
    <p>In this guide</p>
    <ul>
      {sections.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}
    </ul>
  </nav>
  <article aria-label="Member guide">
    <slot />
    <p class="back"><a href="#top">Back to the top</a></p>
  </article>
</main>

<style>
  .oy-reading-guide {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-4) var(--gutter) var(--space-7);
    font-size: 18px;
    line-height: var(--leading-body);
  }

  nav {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-soft);
  }

  nav p {
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: var(--weight-heading-2);
    color: var(--text-heading);
  }

  nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
  }

  /* A link inside a sentence keeps its line: the padding grows what a finger can reach, not the line. */
  article :global(a) {
    padding-block: var(--space-2);
  }

  /* Words run to a short measure; a screenshot may use the whole column. */
  article > :global(*) {
    max-width: 68ch;
  }

  article > :global(figure) {
    max-width: 100%;
    margin: var(--space-4) 0;
  }

  article :global(h1) {
    margin-bottom: var(--space-3);
    font-size: var(--text-hero);
    line-height: var(--leading-heading);
  }

  article :global(h2) {
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-soft);
    font-size: var(--text-h2);
    scroll-margin-top: var(--space-2);
  }

  article :global(h3) {
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    font-size: var(--text-h3);
    scroll-margin-top: var(--space-3);
  }

  article :global(p),
  article :global(ol),
  article :global(ul) {
    margin-block: var(--space-3);
  }

  article :global(ol),
  article :global(ul) {
    padding-left: var(--space-5);
  }

  article :global(li) {
    margin-block: var(--space-2);
    padding-left: var(--space-1);
  }

  /* The step numbers keep the list's own markers, so a screen reader still counts the steps. */
  article :global(ol > li::marker) {
    font-weight: 700;
    color: var(--text-heading);
  }

  /* Bold is kept for the words on the Studio's screen. */
  article :global(strong) {
    color: var(--text-heading);
  }

  article :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-media);
  }

  article :global(figcaption) {
    margin-top: var(--space-2);
    font-size: var(--text-body-size);
    color: var(--text-muted);
  }

  article :global(aside) {
    margin-block: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border-soft);
    border-left: 4px solid var(--indigo-700);
    border-radius: var(--radius-card);
    background: var(--surface-alt);
  }

  article :global(aside > p:first-child) {
    font-family: var(--font-display);
    font-weight: var(--weight-heading-2);
    color: var(--text-heading);
  }

  .back {
    margin-top: var(--space-6);
  }

  @media (min-width: 960px) {
    .oy-reading-guide {
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: var(--space-6);
    }

    /* A scrolling box clips what leaves it, so the list keeps room for a link's focus ring. */
    nav {
      position: sticky;
      top: var(--space-4);
      align-self: start;
      max-height: calc(100vh - 2 * var(--space-4));
      margin-inline: calc(-1 * var(--space-2));
      padding: 0 var(--space-2) var(--space-2);
      overflow-y: auto;
      border-bottom: 0;
    }
  }

  @media print {
    .oy-reading-guide {
      display: block;
      max-width: none;
      padding: 0;
    }

    nav,
    .back {
      display: none;
    }

    article > :global(*) {
      max-width: none;
    }

    article :global(h2),
    article :global(h3) {
      break-after: avoid;
    }

    article :global(li),
    article :global(figure),
    article :global(aside) {
      break-inside: avoid;
    }
  }
</style>
