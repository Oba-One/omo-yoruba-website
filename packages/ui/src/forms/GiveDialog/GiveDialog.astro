---
/**
 * The dialog every Donate trigger opens (CONTEXT.md, Give Dialog): the Zeffy donation form in the shell
 * every Zeffy form opens in (`ZeffyDialog.astro`, ADR 0050), which mounts the embed, times the fallback
 * and hears Zeffy's messages (ADR 0045). These are the Give Dialog's own words. Its fallback: write to us,
 * send a check to the mailing address (the registry's chip while Organization details hold none, the
 * organization's name only before an address), Contact us (the contact enquiry) and Try again. Under the
 * form a link opens Zeffy's own page for it in a new tab, where Apple Pay and Google Pay can show, and the
 * foot names Zeffy and the EIN. Nothing here says the form offers monthly giving or emails receipts until
 * the owner words it (open-work C12). `mode="pending"` is the answer while Organization details hold no
 * donation form. `#give` in the URL opens the dialog on load. Announces `give_opened`,
 * `give_embed_failed`, `give_completed` and `give_page_opened` as `oy:track` events (ADR 0018).
 */
import { pendingWhat } from '@oy/content/pending';
import { sentence } from '../../content/sentence';
import Pending from '../../core/Pending/Pending.astro';
import type { ZeffyDialogCopy, ZeffyDialogMode } from '../ZeffyDialog/dialog';
import ZeffyDialog from '../ZeffyDialog/ZeffyDialog.astro';

export type GiveMode = ZeffyDialogMode;

interface Props {
  /** Renders the dialog open. The site opens it only for `#give`. */
  open?: boolean;
  /** The server state: the embed box, the fallback, or the Pending answer. */
  mode?: GiveMode;
  /** The organization name and mailing address for the check line; Pending while empty. */
  orgName?: string | null;
  address?: string | null;
  ein?: string | null;
  /** Zeffy's own page for the form (`zeffyPageHref`), linked under the embed; none draws no link. */
  pageHref?: string | null;
  /** Milliseconds before the fallback shows; stories shorten it. */
  timeout?: number;
}

const { open, mode, orgName, address, ein, pageHref, timeout } = Astro.props;

const COPY: ZeffyDialogCopy = {
  title: 'Give to Omo Yorùbá',
  lead: {
    embed: 'Amount and card details, all here.',
    fallback: 'Two other ways to give while the form is down.',
  },
  heading: 'The giving form did not load.',
  pending: {
    lead: 'Two ways to give until the online form is set up.',
    heading: 'The online giving form is not set up yet.',
  },
  loading: 'Loading the giving form...',
  page: {
    note: "On a phone, Zeffy's own page can take Apple Pay and Google Pay. It opens in a new tab.",
    label: "Give on Zeffy's page",
  },
  enquiry: { kind: 'contact', label: 'Contact us' },
};
// Where a check goes: the name before the address, and only before one. Without an address the
// line shows the registry's chip, never a name alone to post a check to.
const addressLines = (address ?? '')
  .split(/\r?\n/)
  .map((line) => line.trim())
  .filter(Boolean);
const checkTo =
  addressLines.length > 0
    ? [orgName?.trim(), ...addressLines].filter(Boolean).join(', ')
    : undefined;
const einText = ein?.trim() || 'XX-XXXXXXX';
---

<ZeffyDialog form="give" copy={COPY} open={open} mode={mode} pageHref={pageHref} timeout={timeout}>
  <slot name="embed" slot="embed" />
  <Fragment slot="fallback">
    Write to us and we will take the gift by hand, or send a check to{' '}
    {checkTo ? <span>{sentence(checkTo)}</span> : <Pending what={pendingWhat('siteSettings', 'address')} />}
  </Fragment>
  <span slot="foot">501(c)(3) • EIN <span data-ein>{einText}</span></span>
</ZeffyDialog>
