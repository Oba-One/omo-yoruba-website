---
/**
 * A program on the homepage and the Programs hub (`02 Homepage.dc.html`): the photo or the
 * placeholder, the name, the blurb and one quiet action from the Studio, on the card base. The
 * highlighted card (`data-highlight` on the page root, the `highlight` option) moves first and
 * takes the gold ring, the prototype's page rule ported below; the Collective's link reads
 * green, the one place green lives outside its page. A missing blurb shows the registry's chip;
 * without an action the card has no link.
 */
import { pendingWhat } from '@oy/content/pending';
import ActionButton from '../../core/ActionButton/ActionButton.astro';
import type { ActionLike } from '../../core/ActionButton/action';
import Pending from '../../core/Pending/Pending.astro';
import ImagePlaceholder from '../../media/ImagePlaceholder/ImagePlaceholder.astro';
import type { ImageInput } from '../../media/image';
import Card from '../Card/Card.astro';

export interface ProgramLike {
  name?: string | null;
  slug?: string | null;
  blurb?: string | null;
  image?: ImageInput | null;
  page?: string | null;
  action?: ActionLike | null;
}

interface Props {
  program: ProgramLike;
  /** A `data-sanity` attribute for the photo. */
  imageEdit?: string;
  class?: string;
}

/** The prototype's class per highlight value (`school` is the stored value for the Lessons). */
const HIGHLIGHT_CLASS: Record<string, string> = {
  lessons: 'v2-prog--school',
  collective: 'v2-prog--collective',
};

const { program, imageEdit, class: className } = Astro.props;
const name = program.name?.trim();
const action: ActionLike | undefined = program.action?.label ? program.action : undefined;
const blurbPending = pendingWhat('program', 'blurb');
---

<Card
  title={name || undefined}
  image={program.image}
  imageEdit={imageEdit}
  alt=""
  mediaHeight={170}
  class:list={[program.page && HIGHLIGHT_CLASS[program.page], className]}
  data-program={program.page ?? program.slug ?? undefined}
>
  {
    !program.image && (
      <ImagePlaceholder
        slot="media"
        what={`a photo of ${name ?? 'the program'}`}
        aspect="360 / 170"
        class="oy-program-placeholder"
      />
    )
  }
  <p>{program.blurb || <Pending what={blurbPending} />}</p>
  {action && <ActionButton action={action} variant="quiet" class="oy-program-link" />}
</Card>

<style>
  :global(.oy-card) > :global(.oy-program-placeholder) {
    height: 170px;
    aspect-ratio: auto;
  }
  :global([data-program='collective']) :global(.oy-program-link) {
    color: var(--green-600);
  }
  /* The highlight option (02 Homepage.dc.html): the chosen program leads with the gold ring. */
  :global(.oy-home[data-highlight='school'] .v2-prog--school),
  :global(.oy-home[data-highlight='collective'] .v2-prog--collective) {
    order: -1;
    border-color: var(--gold-500);
    box-shadow: inset 0 0 0 1px var(--gold-500);
  }
</style>
