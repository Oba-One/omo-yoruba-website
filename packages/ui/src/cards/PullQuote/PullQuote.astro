---
/**
 * A member voice (`02 Homepage.dc.html`, Member voices): the ayo dot row, the quote in the
 * display face, the name and relation in the caption, on the card base, filling its grid cell.
 * Without permission to name, the caption shows initials only. Without a testimonial the card
 * shows the registry's Pending chip (ADR 0014), then the prototype's placeholder when the page
 * names the slot (the quote it wants in brackets, "Name pending" with the voice), so the voices
 * section keeps its three-column rhythm while the owner gathers quotes. The `single` variant is
 * the Collective's one voice (`12 Yoruba Cultural Collective.dc.html`): the tokens' large
 * `.oy-quote` figure on the page, not a card, in the same three states. `pending` gives the
 * page's own registry wording.
 */
import { pendingWhat, type VoiceSlot } from '@oy/content/pending';
import Divider from '../../core/Divider/Divider.astro';
import Pending from '../../core/Pending/Pending.astro';
import Card from '../Card/Card.astro';
import { initialsOf } from './initials';

export interface TestimonialLike {
  quote?: string | null;
  name?: string | null;
  relation?: string | null;
  permissionToName?: boolean | null;
}

interface Props {
  testimonial?: TestimonialLike | null;
  /** The slot this quote waits in while there is no testimonial (`HOMEPAGE_VOICE_SLOTS`). */
  placeholder?: VoiceSlot | null;
  /** `card` in a grid of voices; `single`, one large quote on the page. */
  variant?: 'card' | 'single';
  /** The registry's wording for the missing voice; the homepage's by default. */
  pending?: string;
  class?: string;
}

const {
  testimonial,
  placeholder,
  variant = 'card',
  pending = pendingWhat('homepage', 'voices[]'),
  class: className,
} = Astro.props;
const name = testimonial?.name?.trim();
const who = name ? (testimonial?.permissionToName ? name : initialsOf(name)) : undefined;
const parts = [who, testimonial?.relation?.trim()].filter(Boolean);
const waiting = testimonial ? undefined : 'true';
---

{
  variant === 'single' ? (
    <figure class:list={['oy-quote', 'oy-quote-single', className]} data-pending={waiting}>
      <Divider kind="ayo" />
      {testimonial ? (
        <>
          {testimonial.quote && <blockquote>{testimonial.quote}</blockquote>}
          {parts.length > 0 && <figcaption>{parts.join(' • ')}</figcaption>}
        </>
      ) : placeholder ? (
        <>
          <Pending what={pending} class="oy-quote-pending" />
          <blockquote>[ {placeholder.quote} ]</blockquote>
          <figcaption>Name pending • {placeholder.role}</figcaption>
        </>
      ) : (
        <>
          <blockquote>
            <Pending what={pending} />
          </blockquote>
          <figcaption>Name pending</figcaption>
        </>
      )}
    </figure>
  ) : (
    <Card as="figure" class:list={['oy-quote-card', className]} data-pending={waiting}>
      <Divider kind="ayo" />
      {testimonial ? (
        <>
          {testimonial.quote && <blockquote class="oy-quote-text">{testimonial.quote}</blockquote>}
          {parts.length > 0 && <figcaption class="oy-quote-who">{parts.join(' • ')}</figcaption>}
        </>
      ) : placeholder ? (
        <>
          <Pending what={pending} class="oy-quote-pending" />
          <blockquote class="oy-quote-text">[ {placeholder.quote} ]</blockquote>
          <figcaption class="oy-quote-who">Name pending • {placeholder.role}</figcaption>
        </>
      ) : (
        <>
          <blockquote class="oy-quote-text">
            <Pending what={pending} />
          </blockquote>
          <figcaption class="oy-quote-who">Name pending</figcaption>
        </>
      )}
    </Card>
  )
}

<style>
  .oy-quote-card :global(.oy-card-body) {
    gap: 14px;
  }
  .oy-quote-card :global(.oy-quote-pending) {
    align-self: flex-start;
  }
  /* The prototype widens the tokens' 720px to 760px for the Collective's quote. */
  .oy-quote-single {
    max-width: 760px;
  }
  .oy-quote-single :global(.oy-quote-pending) {
    margin-bottom: 14px;
  }
  .oy-quote-text {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    line-height: 1.5;
    color: var(--indigo-700);
  }
  .oy-quote-who {
    margin-top: auto;
    padding-top: 6px;
    font-size: 14px;
    color: var(--text-muted);
  }
  :global(.oy-dark) .oy-quote-text {
    color: var(--white);
  }
</style>
