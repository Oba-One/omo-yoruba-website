---
/**
 * A news entry (`02 Homepage.dc.html`, News & events): the month and year in the small caps
 * line, the title, the summary and a quiet Read more, on the card base. The link appears only
 * when the page supplies an href: the News page waits on its cadence (wayfinder ticket 08), so
 * until it exists the homepage passes the page the post is tagged to (`newsHref` in
 * packages/web), never a post route that is not planned. The date is read from the post's ISO
 * date and written in words.
 */
import Button from '../../core/Button/Button.astro';
import type { BilingualText } from '../../core/Kicker/Kicker.astro';
import Card from '../Card/Card.astro';
import { monthYear } from './date';

export interface PostLike {
  title?: string | null;
  date?: string | null;
  kicker?: BilingualText | null;
  summary?: string | null;
}

interface Props {
  post: PostLike;
  /** Where Read more goes: the page the post is tagged to until the News page exists. */
  href?: string;
  class?: string;
}

const { post, href, class: className } = Astro.props;
const when = monthYear(post.date);
---

<Card title={post.title || undefined} kicker={post.kicker} class:list={['oy-news-card', className]}>
  {when && <span class="oy-card-date">{when}</span>}
  {post.summary && <p>{post.summary}</p>}
  {
    href && (
      <Button variant="quiet" href={href} arrow>
        Read more{post.title && <span class="oy-news-about">: {post.title}</span>}
      </Button>
    )
  }
</Card>

<style>
  /* The post's title completes the link's name without showing twice. */
  .oy-news-about {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* The date sits first in the body, above the kicker and the title. */
  .oy-news-card :global(.oy-card-body) {
    display: flex;
  }
  .oy-news-card :global(.oy-card-date) {
    order: -1;
  }
</style>
