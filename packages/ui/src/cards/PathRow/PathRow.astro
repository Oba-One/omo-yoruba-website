---
/**
 * The row form of a door or a way in (`02 Homepage.dc.html`, the rows option; the take-part rows of
 * `08 Odunde Festival.dc.html` and `09 End-of-Year Gala.dc.html`; COMPONENT-MAP, Cards): the chip
 * naming the way in, the title and one line, one action that opens an enquiry kind or the Give
 * Dialog. Two sources: a homepage `door`, whose key names the chip and the accent, or a take-part
 * row's own `way`, `chip`, `title`, `line` and `action` (`TakePartBand`): any of the nine ways in,
 * each opening its enquiry kind, the Give Dialog, or for `updates` the newsletter form, and wearing the
 * row's own chip where the page names one ("Partner" on the Collective's sponsor row). The chip's
 * accent follows the way in through the tokens (`data-accent`; enrol and member share the performer
 * accent, updates the give accent); the border deepens on hover, no rule, no lift. The default slot
 * follows the line inside its paragraph (the festival's vendor terms). The action is outline by
 * default, gold once per view, quiet for the give and updates rows. The door chips and accents come
 * from `@oy/content/doors`, one chip per door across the site (ADR 0034).
 */
import { DOOR_ACCENTS, DOOR_CHIPS, isDoorKey } from '@oy/content/doors';
import { pendingWhat } from '@oy/content/pending';
import ActionButton from '../../core/ActionButton/ActionButton.astro';
import { type ActionLike, resolveAction } from '../../core/ActionButton/action';
import type { ButtonVariant } from '../../core/Button/Button.astro';
import Pending from '../../core/Pending/Pending.astro';
import type { DoorLike } from '../DoorCard/DoorCard.astro';

interface Props {
  /** A homepage door: its key names the chip and the accent. */
  door?: DoorLike;
  /** A take-part row's way in, which names the accent; ignored with `door`. */
  way?: string | null;
  chip?: string;
  title?: string | null;
  line?: string | null;
  action?: ActionLike | null;
  /** The registry's wording where a take-part row is missing its way in, title or button label. */
  pending?: string;
  /** The gold action: once per view. */
  primary?: boolean;
  /** The action's look; overrides `primary` (the give row's action is quiet). */
  variant?: ButtonVariant;
  /** A `data-sanity` attribute, so click-to-edit reaches the row. */
  edit?: string;
  class?: string;
}

const { door, primary = false, variant, edit, class: className } = Astro.props;
const key = door?.key ?? '';
const known = isDoorKey(key) ? key : undefined;
const row = door
  ? {
      chip: known && DOOR_CHIPS[known],
      accent: known && DOOR_ACCENTS[known],
      title: door.title,
      line: door.blurb,
      action: door.action,
      chipPending: 'the way in',
      linePending: pendingWhat('door', 'blurb'),
      rowPending: undefined,
    }
  : {
      chip: Astro.props.chip,
      accent: Astro.props.way ?? undefined,
      title: Astro.props.title,
      line: Astro.props.line,
      action: Astro.props.action,
      chipPending: Astro.props.pending ?? 'the way in',
      linePending: undefined,
      rowPending: Astro.props.pending,
    };
const title = row.title?.trim();
const line = row.line?.trim();
const hasTerms = Astro.slots.has('default');
const actionReady = resolveAction(row.action)?.ok === true;
---

<div
  class:list={['oy-path', className]}
  data-door={key || undefined}
  data-way={door ? undefined : row.accent}
  data-accent={row.accent}
  data-sanity={edit}
>
  <span class="oy-path-chip">{row.chip ?? <Pending what={row.chipPending} />}</span>
  <div class="oy-path-body">
    {
      title ? (
        <h3>{title}</h3>
      ) : (
        row.rowPending && (
          <h3>
            <Pending what={row.rowPending} />
          </h3>
        )
      )
    }
    {
      line || hasTerms ? (
        <p>
          {line}
          {line && hasTerms && ' '}
          <slot />
        </p>
      ) : (
        row.linePending && (
          <p>
            <Pending what={row.linePending} />
          </p>
        )
      )
    }
  </div>
  {
    actionReady ? (
      <ActionButton action={row.action} variant={variant ?? (primary ? 'primary' : 'secondary')} />
    ) : (
      row.rowPending && <Pending what={row.rowPending} />
    )
  }
</div>
