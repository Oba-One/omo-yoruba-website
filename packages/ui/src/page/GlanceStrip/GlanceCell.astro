---
/**
 * One cell of the glance strip: the label, the value or its chip, and the note or its chip. A note with a
 * safe `noteHref` is a link with a 44px target (Impact's board cell linking to Our Story).
 */
import { safeHref } from '../../core/ActionButton/action';
import Pending from '../../core/Pending/Pending.astro';
import type { GlanceFact } from './GlanceStrip.astro';

interface Props {
  fact: GlanceFact;
}

const { fact } = Astro.props;
const href = safeHref(fact.noteHref);
---

<div>
  <b>{fact.label}</b>
  {fact.value?.trim() ? <span>{fact.value}</span> : <Pending what={fact.pending} />}
  {
    fact.note?.trim() ? (
      <small>{href ? <a class="oy-glance-link" href={href}>{fact.note}</a> : fact.note}</small>
    ) : (
      fact.notePending && (
        <small>
          <Pending what={fact.notePending} />
        </small>
      )
    )
  }
</div>

<style>
  /* A link on its own under a figure: padding takes it to the 44px target without moving the cell. */
  .oy-glance-link {
    display: inline-block;
    padding: 12px 0;
    margin: -12px 0;
  }
</style>
