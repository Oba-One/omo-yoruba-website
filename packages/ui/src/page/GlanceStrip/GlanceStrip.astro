---
/**
 * The glance strip under an event page's header (COMPONENT-MAP, Page structure; CONTEXT, Glance
 * strip): the hard facts of the next edition in a row of four or five cells on white, each a
 * terracotta label, the value in the display face and an optional note, with the registry's chip
 * wherever the Studio holds no value. Five show at most; under 900px the cells fall into two
 * columns (the tokens' `.oy-glance`). An optional line under the strip speaks to the reader. Without
 * its band the strip sits inside a column (an initiative's four facts on the Collective page). A strip
 * with no facts shows the registry's Pending line in the band when the page passes its wording.
 */
import Pending from '../../core/Pending/Pending.astro';
import GlanceCell from './GlanceCell.astro';

export interface GlanceFact {
  label: string;
  value?: string | null;
  note?: string | null;
  /** The registry's wording when the value is missing. */
  pending?: string;
  /** The registry's wording when the note is a missing fact (the venue line). */
  notePending?: string;
  /** Makes the note a link when the href is safe. */
  noteHref?: string | null;
}

interface Props {
  facts: GlanceFact[];
  /** A line under the strip. */
  caption?: string | null;
  /** The white band and the page wrap around the strip; off inside a column. */
  band?: boolean;
  /** The registry's wording for a strip with no facts. */
  pending?: string;
  /** A `data-sanity` attribute for the strip. */
  edit?: string;
  id?: string;
  class?: string;
}

const { facts, caption, band = true, pending, edit, id = 'glance', class: className } = Astro.props;
const shown = facts.slice(0, 5);
const columns = shown.length === 5 ? undefined : String(shown.length);
---

{
  band ? (
    <div class:list={['oy-glance-band', className]} id={id} data-sanity={edit}>
      <div class="oy-wrap">
        {shown.length === 0 && pending ? (
          <Pending variant="line" what={pending} />
        ) : (
          <div class="oy-glance" data-cols={columns}>
            {shown.map((fact) => (
              <GlanceCell fact={fact} />
            ))}
          </div>
        )}
        {caption && <p class="oy-glance-caption">{caption}</p>}
      </div>
    </div>
  ) : (
    <div
      class:list={['oy-glance', 'oy-glance--inline', className]}
      data-cols={columns}
      data-sanity={edit}
    >
      {shown.map((fact) => (
        <GlanceCell fact={fact} />
      ))}
    </div>
  )
}

<style>
  .oy-glance-band {
    background: var(--white);
    padding: 40px 0 8px;
  }
  .oy-glance :global(.oy-pend) {
    margin-top: 10px;
  }
  .oy-glance :global(small .oy-pend) {
    margin-top: 0;
  }
  /* Under a paragraph in its column; first in a column (a split's aside) it aligns with the heading. */
  :global(*) + .oy-glance--inline {
    margin-top: 20px;
  }
  .oy-glance-caption {
    margin: 14px 0 0;
    font-size: 14px;
    color: var(--text-muted);
  }
</style>
