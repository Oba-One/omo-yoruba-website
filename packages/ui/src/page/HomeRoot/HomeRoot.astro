---
/**
 * The homepage root as the prototype carries it: `.oy-home` with the grain-dots card texture, the
 * theme (`data-theme`, `adire` by default as on the site, which sets the band and alternate section
 * surfaces) and the data attributes the layout options drive (`data-highlight`, `data-pattern`,
 * `data-motion`, `data-season`, `data-involved`, `data-newsletter`, `data-gallery`), which the
 * tokens' rules read. The site puts the same attributes on `<body>` through the layout; the
 * page-section stories wrap a section in this so the owner compares each option in Storybook.
 */
interface Props {
  theme?: 'adire' | 'calm' | 'festival';
  highlight?: 'festival' | 'school' | 'collective';
  pattern?: 'rich' | 'subtle';
  /** `on` breathes and rises; `off` settles everything. */
  motion?: 'on' | 'off';
  season?: 'auto' | 'gala' | 'odunde';
  involved?: 'doors' | 'rows';
  newsletter?: 'footer' | 'band';
  gallery?: '7' | '5' | '3';
  class?: string;
}

const {
  theme = 'adire',
  highlight = 'festival',
  pattern = 'rich',
  motion = 'on',
  season,
  involved,
  newsletter,
  gallery,
  class: className,
} = Astro.props;
---

<div
  class:list={['oy-home', className]}
  data-card="grain-dots"
  data-theme={theme}
  data-highlight={highlight}
  data-pattern={pattern}
  data-motion={motion === 'off' ? 'false' : 'true'}
  data-season={season}
  data-involved={involved}
  data-newsletter={newsletter}
  data-gallery={gallery}
>
  <slot />
</div>
