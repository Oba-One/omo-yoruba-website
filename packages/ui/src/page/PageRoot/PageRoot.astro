---
/**
 * An inner page's root for the page-section stories: `.oy-home` with the grain-dots card texture,
 * the theme (`adire` by default, as on the site) and one data attribute per layout option the page
 * passes (`data-phead`, `data-treatment` and the rest), which the tokens' and the components' rules
 * read. The site puts the same attributes on `<body>` through the layout; `HomeRoot` is the
 * homepage's named form.
 */
interface Props {
  theme?: 'adire' | 'calm' | 'festival';
  /** Layout option names and values: `{ phead: 'slim' }` becomes `data-phead="slim"`. */
  options?: Record<string, string | undefined>;
  class?: string;
}

const { theme = 'adire', options = {}, class: className } = Astro.props;
const attributes = Object.fromEntries(
  Object.entries(options)
    .filter(([, value]) => value !== undefined)
    .map(([name, value]) => [`data-${name}`, value]),
);
---

<div class:list={['oy-home', className]} data-card="grain-dots" data-theme={theme} {...attributes}>
  <slot />
</div>
