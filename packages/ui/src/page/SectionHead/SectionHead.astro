---
/**
 * The head of a homepage section: the small aṣọ òkè swatch beside the bilingual kicker, the H2
 * and an optional intro on the left, an optional quiet link on the right (`02 Homepage.dc.html`).
 * A note can follow the intro in the same paragraph, or the registry's chip while it is owed (the
 * festival's past years: its intro, then the past edition's attendance).
 * The heading takes `id` so the section can be labelled by it. Empty kicker halves render a
 * single kicker; no kicker renders none. The intro is the page prototypes' section lead (`.oy-sec-lead`:
 * 64ch, 12px under the heading), and the heading sits 6px under a kicker and flush without one, as they
 * draw it. A dark closing band's kicker can go without the swatch (`14 Impact.dc.html`, Fund the next year).
 */
import Button from '../../core/Button/Button.astro';
import Kicker, { type BilingualText } from '../../core/Kicker/Kicker.astro';
import Pending from '../../core/Pending/Pending.astro';

interface Props {
  kicker?: BilingualText | null;
  /** The aṣọ òkè swatch beside the kicker; on by default. */
  swatch?: boolean;
  title?: string | null;
  /** The registry's wording for a missing heading; without it an empty heading renders nothing. */
  pending?: string;
  intro?: string | null;
  /** A sentence after the intro, in the same paragraph. */
  note?: string | null;
  /** The registry's wording in place of a missing note; without it a missing note renders nothing. */
  notePending?: string;
  link?: { label: string; href: string } | null;
  /** The id of the heading, for `aria-labelledby` on the section. */
  id?: string;
  class?: string;
}

const {
  kicker,
  swatch = true,
  title,
  intro,
  note,
  notePending,
  link,
  id,
  pending,
  class: className,
} = Astro.props;
const noteShown = note?.trim() || notePending;
const hasKicker = Boolean(kicker?.yo || kicker?.en);
---

<div class:list={['oy-sec-head', className]}>
  <div>
    {
      hasKicker && (
        <div class="oy-sec-kicker">
          {swatch && <span class="oy-sec-swatch" aria-hidden="true" />}
          <Kicker yo={kicker?.yo ?? undefined} en={kicker?.en ?? undefined} />
        </div>
      )
    }
    {(title?.trim() || pending) && <h2 id={id}>{title?.trim() || <Pending what={pending} />}</h2>}
    {
      (intro || noteShown) && (
        <p class="oy-sec-intro">
          {intro}
          {intro && noteShown && ' '}
          {note?.trim() || (notePending && <Pending what={notePending} />)}
        </p>
      )
    }
  </div>
  {
    link && (
      <Button variant="quiet" href={link.href} class="oy-sec-link" arrow>
        {link.label}
      </Button>
    )
  }
</div>

<style>
  .oy-sec-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .oy-sec-swatch {
    display: inline-block;
    width: 26px;
    height: 10px;
    background: var(--pattern-asoke);
    flex: none;
  }
  .oy-sec-kicker + h2 {
    margin-top: 6px;
  }
  .oy-sec-intro {
    margin: 12px 0 0;
    max-width: 64ch;
    font-size: var(--text-body-size);
    line-height: 1.7;
    color: var(--text-muted);
  }
  .oy-sec-head :global(.oy-sec-link) {
    margin-left: auto;
  }
</style>
