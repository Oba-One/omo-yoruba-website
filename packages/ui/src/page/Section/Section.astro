---
/**
 * A page section at the content width: `.oy-section` with the alternate paper ground when asked,
 * an optional batik wash or the stat strip's corner dot fields behind the content, and the slot
 * inside `.oy-wrap`. Pages compose sections from this and `SectionHead`; the textures come from
 * the tokens and the pattern option on the page root dims them.
 */
import PatternBand from '../../bands/PatternBand/PatternBand.astro';

interface Props {
  id?: string;
  /** The paper ground (`.oy-section--alt`). */
  alt?: boolean;
  /** A texture behind the content: the batik wash, or the two corner dot fields. */
  texture?: 'batik' | 'corners' | 'none';
  /** The id of the heading that labels the section. */
  labelledby?: string;
  class?: string;
}

const { id, alt = false, texture = 'none', labelledby, class: className, ...rest } = Astro.props;
---

<section
  id={id}
  class:list={['oy-section', alt && 'oy-section--alt', texture !== 'none' && 'oy-section--textured', className]}
  aria-labelledby={labelledby}
  {...rest}
>
  {texture === 'batik' && <PatternBand pattern="batik" />}
  {
    texture === 'corners' && (
      <>
        <div class="v2-corner v2-corner--tl" aria-hidden="true" />
        <div class="v2-corner v2-corner--br" aria-hidden="true" />
      </>
    )
  }
  <div class="oy-wrap oy-section-inner">
    <slot />
  </div>
</section>

<style>
  .oy-section--textured {
    position: relative;
    overflow: hidden;
  }
  .oy-section--textured .oy-section-inner {
    position: relative;
  }
</style>
