---
/**
 * The homepage hero (`02 Homepage.dc.html`): the photo behind a scrim with the àdìrẹ dot field,
 * breathing slowly when motion is on (`.v2-kb`, off under reduced motion and the page's
 * `data-motion="false"`), and the copy set left in a 640px column: the kicker, the H1 with its
 * gold words in italic, the line under it, one gold action with the outline actions beside it,
 * and the blessing line in the display italic. Without a photo the hero keeps the theme's surface
 * and shows a Pending chip for the photograph; without a heading the H1 carries a Pending chip, so
 * the page still has its one H1.
 */
import { pendingWhat } from '@oy/content/pending';
import ActionButton from '../../core/ActionButton/ActionButton.astro';
import type { ActionLike } from '../../core/ActionButton/action';
import Divider from '../../core/Divider/Divider.astro';
import Kicker, { type BilingualText } from '../../core/Kicker/Kicker.astro';
import Pending from '../../core/Pending/Pending.astro';
import { altOf, type ImageInput, imgAttributes, positionOf } from '../../media/image';
import { splitEmphasis } from './emphasis';

interface Props {
  image?: ImageInput | null;
  alt?: string;
  kicker?: BilingualText | null;
  title?: string | null;
  /** The part of the heading set in gold italic ("alive"); matched exactly, first occurrence. */
  emphasis?: string | null;
  sub?: string | null;
  blessing?: BilingualText | null;
  primary?: ActionLike | null;
  secondary?: ActionLike[] | null;
  /** The breathing photo and the entrance rise; off renders everything settled. */
  motion?: boolean;
  /** A `data-sanity` attribute for the photo, so click-to-edit reaches the image field. */
  imageEdit?: string;
  /** A `data-sanity` attribute for the hero itself, so click-to-edit reaches the motion option. */
  edit?: string;
  class?: string;
}

const {
  image,
  alt,
  kicker,
  title,
  emphasis,
  sub,
  blessing,
  primary,
  secondary = [],
  motion = true,
  imageEdit,
  edit,
  class: className,
  ...rest
} = Astro.props;

const img = imgAttributes(image, '100vw');
const position = positionOf(image);
const rise = motion ? 'v2-rise' : undefined;
// The heading is rendered as stored (trimming could cut the edit link stega appends); the gold
// words split it only when they occur in it, and the Studio warns when they do not.
const split = splitEmphasis(title, emphasis);
---

<header class:list={['oy-dark', 'v2-hero', 'oy-hero-band', className]} id="top" data-sanity={edit} {...rest}>
  {
    img ? (
      <img
        class:list={['oy-hero-photo', motion && 'v2-kb']}
        {...img}
        alt={altOf(image, alt ?? '')}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        style={position ? `object-position: ${position}` : undefined}
        data-sanity={imageEdit}
      />
    ) : (
      <Pending what={pendingWhat('homepage', 'hero.image')} class="oy-hero-pending" />
    )
  }
  <div class="v2-hero-scrim" aria-hidden="true"></div>
  <div class="v2-dots" aria-hidden="true"></div>
  <div class="oy-wrap oy-hero-band-inner">
    <div class="oy-hero-copy">
      {(kicker?.yo || kicker?.en) && <Kicker yo={kicker?.yo ?? undefined} en={kicker?.en ?? undefined} class={rise} />}
      <h1 class={rise} style="animation-delay: 0.12s">
        {
          !title?.trim() ? (
            <Pending what={pendingWhat('homepage', 'hero.title')} />
          ) : split ? (
            <>
              {split.before}
              <em>{split.accent}</em>
              {split.after}
            </>
          ) : (
            title
          )
        }
      </h1>
      {sub && <p class:list={['oy-hero-sub', rise]} style="animation-delay: 0.24s">{sub}</p>}
      <div class:list={['v2-hero-cta', rise]} style="animation-delay: 0.36s">
        <ActionButton action={primary} variant="primary" />
        {(secondary ?? []).map((action) => (
          <ActionButton action={action} variant="secondary" arrow={false} />
        ))}
      </div>
      {
        (blessing?.yo || blessing?.en) && (
          <p class:list={['oy-hero-blessing', rise]} style="animation-delay: 0.5s">
            {blessing?.yo && <span lang="yo">{blessing.yo}</span>}
            {blessing?.yo && blessing?.en && (
              <span class="oy-hero-blessing-dot" aria-hidden="true">
                •
              </span>
            )}
            {blessing?.en && <span class="oy-hero-blessing-en">{blessing.en}</span>}
          </p>
        )
      }
    </div>
  </div>
  <Divider kind="asoke" class="oy-hero-edge" />
</header>

<style>
  .oy-hero-band {
    background: var(--hero-surface, var(--indigo-900));
  }
  .oy-hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 35% 35%;
  }
  .oy-hero-pending {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 1;
  }
  /* Not `.oy-hero-inner`: the tokens' generic hero centres that class. */
  .oy-hero-band-inner {
    position: relative;
    width: 100%;
    padding-top: 64px;
    padding-bottom: 72px;
  }
  .oy-hero-copy {
    max-width: 640px;
  }
  /* The prototype's own scale for the photo hero, times the theme's (1 for `adire` and `calm`). */
  .oy-hero-band h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: calc(var(--text-hero-photo) * var(--theme-hero-scale, 1));
    line-height: 1.12;
    color: var(--white);
    margin: 18px 0 14px;
  }
  /* 600, as the prototype shows it: its only italic face of the display type is the 600. */
  .oy-hero-band h1 em {
    font-style: italic;
    font-weight: 600;
    color: var(--gold-300);
  }
  .oy-hero-sub {
    font-size: 18px;
    color: var(--text-on-dark-soft);
    margin: 0 0 30px;
  }
  /* 600: the prototype loads only the 600 italic of the display face, so that is the weight it shows. */
  .oy-hero-blessing {
    margin: 36px 0 0;
    display: flex;
    align-items: baseline;
    gap: 11px;
    flex-wrap: wrap;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: 17px;
    color: var(--gold-300);
  }
  .oy-hero-blessing-dot {
    color: var(--text-on-dark-faint);
  }
  .oy-hero-blessing-en {
    color: var(--text-on-dark-soft);
  }
  .oy-hero-band :global(.oy-hero-edge) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }
</style>
