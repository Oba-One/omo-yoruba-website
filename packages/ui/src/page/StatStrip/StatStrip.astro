---
/**
 * The headline figures (`02 Homepage.dc.html`, `14 Impact.dc.html`; COMPONENT-MAP, Page structure): big
 * serif numbers with a small label each. The `band` is the homepage's: centred on white with the two
 * corner dot fields and a hairline under it, at the page wrap. The `framed` grid is Impact's, inside its
 * section: a white box with a hairline border, the figures left-aligned at 44px, four across or six in
 * two rows of three, two across under 1000px. With `sources` on, each figure carries its source line and a
 * missing source shows the registry's chip. `padPending` fills the grid up to `columns` with that chip
 * (Impact's `six` with four figures). Value and label are required in the Studio, so an empty one renders
 * nothing; no figures at all show the registry's Pending line.
 */
import { pendingWhat } from '@oy/content/pending';
import Pending from '../../core/Pending/Pending.astro';

export interface StripStat {
  value?: string | null;
  label?: string | null;
  source?: string | null;
}

interface Props {
  stats?: StripStat[] | null;
  /** Show the source line under each figure. */
  sources?: boolean;
  /** Four or six figures; by the count when unset. */
  columns?: 4 | 6;
  /** `band` on the homepage; `framed` inside a section (Impact). */
  variant?: 'band' | 'framed';
  /** The registry's wording for each empty cell up to `columns`; without it the grid holds what exists. */
  padPending?: string;
  /** What the Pending line names when there are no figures. */
  what?: string;
  class?: string;
  id?: string;
}

const {
  stats = [],
  sources = false,
  columns = (stats?.length ?? 0) > 4 ? 6 : 4,
  variant = 'band',
  padPending,
  what = pendingWhat('homepage', 'stats[]'),
  class: className,
  ...rest
} = Astro.props;
const list = (stats ?? []).slice(0, columns);
const sourcePending = pendingWhat('stat', 'source');
// The padding waits for figures beside ones that exist; with none at all the Pending line asks for them.
const padding = padPending && list.length > 0 ? Math.max(0, columns - list.length) : 0;
---

{
  variant === 'framed' ? (
    list.length === 0 && padding === 0 ? (
      <div class:list={['oy-stat-grid-pending', className]} {...rest}>
        <Pending variant="line" what={what} />
      </div>
    ) : (
      <div class:list={['oy-stat-grid', className]} data-columns={columns} {...rest}>
        {list.map((stat) => (
          <div class="oy-stat">
            <b>{stat.value}</b>
            <span>{stat.label}</span>
            {sources && <div class="oy-source">{stat.source || <Pending what={sourcePending} />}</div>}
          </div>
        ))}
        {Array.from({ length: padding }, () => (
          <div class="oy-stat oy-stat--owed">
            <Pending what={padPending} />
          </div>
        ))}
      </div>
    )
  ) : (
    <div class:list={['oy-stat-band', className]} {...rest}>
      <div class="v2-corner v2-corner--tl" aria-hidden="true"></div>
      <div class="v2-corner v2-corner--br" aria-hidden="true"></div>
      <div class:list={['oy-wrap', list.length > 0 && 'oy-stat-strip']} data-columns={columns}>
        {list.length > 0 ? (
          list.map((stat) => (
            <div class="oy-stat">
              <b>{stat.value}</b>
              <span>{stat.label}</span>
              {sources && (
                <small class="oy-source">{stat.source || <Pending what={sourcePending} />}</small>
              )}
            </div>
          ))
        ) : (
          <Pending variant="line" what={what} class="oy-stat-pending" />
        )}
      </div>
    </div>
  )
}

<style>
  .oy-stat-band {
    position: relative;
    background: var(--white);
    border-bottom: 1px solid var(--border-soft);
    overflow: hidden;
  }
  .oy-stat-band .oy-wrap {
    position: relative;
  }
  .oy-stat-strip[data-columns='6'] {
    grid-template-columns: repeat(6, 1fr);
  }
  .oy-stat-band .oy-source {
    display: block;
    margin-top: 8px;
    font-size: var(--text-caption);
    color: var(--text-muted);
  }
  .oy-stat-pending {
    margin: 34px 0;
  }
  @media (max-width: 1000px) {
    .oy-stat-strip[data-columns='6'] {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 720px) {
    .oy-stat-strip[data-columns='6'] {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* The framed grid (`14 Impact.dc.html`, Headline numbers). */
  .oy-stat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border-soft);
    border-radius: 6px;
    overflow: hidden;
    background: var(--white);
  }
  .oy-stat-grid[data-columns='6'] {
    grid-template-columns: repeat(3, 1fr);
  }
  .oy-stat-grid > .oy-stat {
    padding: 26px 22px 22px;
    border-left: 1px solid var(--border-soft);
  }
  .oy-stat-grid > .oy-stat:first-child,
  .oy-stat-grid[data-columns='6'] > .oy-stat:nth-child(4) {
    border-left: none;
  }
  .oy-stat-grid[data-columns='6'] > .oy-stat:nth-child(n + 4) {
    border-top: 1px solid var(--border-soft);
  }
  .oy-stat-grid > .oy-stat > b {
    font-size: 44px;
    line-height: 1.05;
  }
  .oy-stat-grid > .oy-stat > span {
    margin-top: 6px;
    font-size: 14.5px;
  }
  .oy-stat-grid > .oy-stat--owed {
    display: flex;
    align-items: flex-start;
  }
  @media (max-width: 1000px) {
    .oy-stat-grid,
    .oy-stat-grid[data-columns='6'] {
      grid-template-columns: 1fr 1fr;
    }
    .oy-stat-grid > .oy-stat,
    .oy-stat-grid[data-columns='6'] > .oy-stat {
      border-left: none;
      border-top: 1px solid var(--border-soft);
    }
    .oy-stat-grid > .oy-stat:nth-child(odd) {
      border-right: 1px solid var(--border-soft);
    }
    .oy-stat-grid > .oy-stat:first-child,
    .oy-stat-grid > .oy-stat:nth-child(2) {
      border-top: none;
    }
  }
</style>
