---
/**
 * A photo tile of the year-in-the-life mosaic (`02 Homepage.dc.html`, COMPONENT-MAP, Cards): the
 * photograph with its caption over a scrim, Yoruba first with the gold dot before the English,
 * square corners, no zoom, framed by the Studio hotspot; the scrim deepens on hover through the
 * tokens. Without a photograph the tile is the placeholder with the àdìrẹ dot field naming the
 * missing photo. The `figure` shape is the framed photograph beside an event page's prose (`08
 * Odunde Festival.dc.html`): 360px tall with the card's 6px corners, or the `height` a page's split draws
 * (280px beside the Collective's argument, 340px beside an initiative). The first half of a caption is
 * marked as Yoruba only when it carries Yoruba letters ("Festival day • Leimert Park" has none). A tile in
 * the first view loads at once (`eager`, an album page's first row), and the page's largest paint first
 * (`priority`); every other tile loads lazily.
 */
import ImagePlaceholder from '../ImagePlaceholder/ImagePlaceholder.astro';
import { altOf, type ImageInput, imgAttributes, positionOf } from '../image';

interface Props {
  image?: ImageInput | null;
  alt?: string;
  /** "Ọdúndé • Festival day at Leimert Park": Yoruba first, the dot, the English. */
  caption?: string | null;
  /** Names the missing photograph in the placeholder. */
  what?: string;
  sizes?: string;
  /** A `data-sanity` attribute for the tile, so click-to-edit reaches the image. */
  edit?: string;
  /** `tile` fills its mosaic cell with square corners; `figure` is the framed 360px photograph. */
  shape?: 'tile' | 'figure';
  /** The figure's height in pixels where a prototype draws it shorter than 360px. */
  height?: number;
  /** A photograph in the first view (an album page's first row): fetched at once rather than lazily. */
  eager?: boolean;
  /** The page's largest paint: fetched first. */
  priority?: boolean;
  class?: string;
}

const {
  image,
  alt,
  caption,
  what = 'a photograph',
  sizes = '(min-width: 1100px) 550px, (min-width: 860px) 50vw, 100vw',
  edit,
  shape = 'tile',
  height,
  eager = false,
  priority = false,
  class: className,
  ...rest
} = Astro.props;

const img = imgAttributes(image, sizes);
const position = positionOf(image);
const [yo, ...restCaption] = (caption ?? '').split(' • ');
const en = restCaption.join(' • ');
// Accented Latin letters or a combining mark: what an English half never carries.
const yoruba = /[\u00c0-\u024f\u1e00-\u1eff]|\p{Mn}/u.test(yo ?? '');
---

<figure
  class:list={['v2-mo', 'oy-photo-tile', shape === 'figure' && 'oy-photo-tile--figure', className]}
  data-sanity={edit}
  style={shape === 'figure' && height ? `--photo-tile-height: ${height}px` : undefined}
  {...rest}
>
  {
    img ? (
      <img
        {...img}
        alt={altOf(image, alt ?? '')}
        loading={eager || priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
        style={position ? `object-position: ${position}` : undefined}
      />
    ) : (
      <ImagePlaceholder what={what} tone="adire" class="oy-photo-tile-placeholder" />
    )
  }
  {
    caption && (
      <figcaption>
        {en ? (
          <>
            <span lang={yoruba ? 'yo' : undefined}>{yo}</span>
            <span class="oy-photo-tile-dot" aria-hidden="true">
              {' • '}
            </span>
            <span>{en}</span>
          </>
        ) : (
          caption
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .oy-photo-tile {
    margin: 0;
    position: relative;
    overflow: hidden;
    min-height: 150px;
  }
  .oy-photo-tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .oy-photo-tile :global(.oy-photo-tile-placeholder) {
    height: 100%;
    aspect-ratio: auto;
  }
  .oy-photo-tile figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 36px 16px 12px;
    background: linear-gradient(180deg, transparent, var(--surface-dark) 130%);
    color: var(--white);
    font-size: 13px;
    font-weight: 600;
  }
  .oy-photo-tile-dot {
    color: var(--gold-300);
  }
  .oy-photo-tile--figure {
    height: var(--photo-tile-height, 360px);
    border-radius: 6px;
  }
  .oy-photo-tile--figure figcaption {
    padding: 40px 18px 14px;
  }
</style>
