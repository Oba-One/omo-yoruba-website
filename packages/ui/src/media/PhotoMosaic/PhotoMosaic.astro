---
import type { ImageInput } from '../image';
/**
 * The year-in-the-life mosaic (`02 Homepage.dc.html`): seven tiles with the first spanning two
 * rows and two columns, five with two wide tiles at the bottom, or three of a kind across; the
 * `gallery` option picks the count. Six is Impact's work in photographs (`14 Impact.dc.html`): two rows
 * of three equal tiles, and three rows of two 160px tiles under 900px. Extra tiles stay out and missing
 * ones are padded with the placeholder, so the arrangement always holds its shape. Two columns under
 * 860px.
 */
import PhotoTile from '../PhotoTile/PhotoTile.astro';

export interface MosaicTile {
  image?: ImageInput | null;
  alt?: string;
  caption?: string | null;
  /** A `data-sanity` attribute for the tile. */
  edit?: string;
}

interface Props {
  tiles?: MosaicTile[] | null;
  count?: 7 | 6 | 5 | 3 | '7' | '6' | '5' | '3';
  /** A `data-sanity` attribute for the mosaic, so click-to-edit reaches the gallery option. */
  edit?: string;
  class?: string;
}

const { tiles = [], count = 7, edit, class: className, ...rest } = Astro.props;
const wanted = Number(count) as 7 | 6 | 5 | 3;
const shown = (tiles ?? []).slice(0, wanted);
const padding = Math.max(0, wanted - shown.length);
---

<div class:list={['v2-mosaic', 'oy-mosaic', className]} data-count={wanted} data-sanity={edit} {...rest}>
  {shown.map((tile) => <PhotoTile image={tile.image} alt={tile.alt} caption={tile.caption} edit={tile.edit} />)}
  {Array.from({ length: padding }, () => <PhotoTile what="a photograph for this tile" />)}
</div>

<style>
  .oy-mosaic {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 168px;
    gap: 14px;
  }
  .oy-mosaic > :global(*:first-child) {
    grid-column: span 2;
    grid-row: span 2;
  }
  .oy-mosaic > :global(*:nth-child(2)),
  .oy-mosaic > :global(*:nth-child(3)) {
    grid-column: span 2;
  }
  .oy-mosaic[data-count='5'] > :global(*:nth-child(4)),
  .oy-mosaic[data-count='5'] > :global(*:nth-child(5)) {
    grid-column: span 2;
  }
  .oy-mosaic[data-count='3'] {
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 250px;
  }
  .oy-mosaic[data-count='3'] > :global(*:first-child),
  .oy-mosaic[data-count='3'] > :global(*:nth-child(2)),
  .oy-mosaic[data-count='3'] > :global(*:nth-child(3)) {
    grid-column: span 1;
    grid-row: span 1;
  }
  .oy-mosaic[data-count='6'] {
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 190px;
  }
  .oy-mosaic[data-count='6'] > :global(*) {
    grid-column: span 1;
    grid-row: span 1;
  }
  @media (max-width: 860px) {
    .oy-mosaic,
    .oy-mosaic[data-count='3'] {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 150px;
    }
    .oy-mosaic > :global(*:first-child) {
      grid-column: span 2;
    }
  }
  /* Six stays equal tiles on a phone: a wide first tile would leave the sixth alone on its row. */
  @media (max-width: 900px) {
    .oy-mosaic[data-count='6'] {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 160px;
    }
    .oy-mosaic[data-count='6'] > :global(*:first-child) {
      grid-column: span 1;
    }
  }
</style>
