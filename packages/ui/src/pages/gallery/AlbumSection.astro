---
/**
 * An album page's body as `/gallery/[album]` composes it, for the `Pages/Gallery` stories: the links back to the
 * gallery and to the edition's page, the credit line with its chip, the photographs and the Lightbox, served open
 * on the first photograph as `open: viewer` arrives or closed as `grid` does. Markup, since the slot tree for a
 * grid of links and a dialog runs deeper than a story's configured slots render (the Programs sections do the
 * same).
 */
import Button from '../../core/Button/Button.astro';
import { GALA_ALBUM, GALA_ALBUM_PHOTOS, GALLERY_PENDING } from '../../fixtures/gallery';
import CreditLine from '../../media/CreditLine/CreditLine.astro';
import Lightbox from '../../media/Lightbox/Lightbox.astro';
import PhotoGrid from '../../media/PhotoGrid/PhotoGrid.astro';
import ButtonRow from '../../page/ButtonRow/ButtonRow.astro';
import Section from '../../page/Section/Section.astro';

interface Props {
  /** The Lightbox served open on the first photograph, as a tile under `open: viewer` arrives. */
  open?: boolean;
  captions?: 'always' | 'hover';
}

const { open = false, captions = 'always' } = Astro.props;
const tiles = GALA_ALBUM_PHOTOS.map(({ key, href, image, tileAlt, caption }) => ({
  key,
  href,
  image,
  alt: tileAlt,
  caption,
}));
---

<Section id="photographs">
  <ButtonRow>
    <Button variant="quiet" href="/gallery">All albums</Button>
    <Button variant="quiet" href={GALA_ALBUM.edition.href} arrow>{GALA_ALBUM.edition.label}</Button>
  </ButtonRow>
  <CreditLine credit={GALA_ALBUM.credit} confirmed={GALA_ALBUM.confirmed} pending={GALLERY_PENDING.credit} />
  <PhotoGrid
    photos={tiles}
    lightbox="album-lightbox"
    captions={captions}
    eager={open ? 0 : 3}
    pending={GALLERY_PENDING.photographs}
  />
  <Lightbox
    id="album-lightbox"
    label={GALA_ALBUM.title}
    albumHref="/gallery/gala-2025"
    album="gala-2025"
    photos={GALA_ALBUM_PHOTOS}
    openKey={open ? GALA_ALBUM_PHOTOS[0]?.key : undefined}
  />
</Section>
