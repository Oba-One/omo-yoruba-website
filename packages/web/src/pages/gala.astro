---
/**
 * The End-of-Year Gala page (`09 End-of-Year Gala.dc.html`, ROUTES sections 1, 4 and 5): composed from
 * the one Gala query through `loadQuery`, showing the next gala edition (ADR 0024) with the registry's
 * Pending chips for every fact the Studio does not hold, "Seats from" derived from the edition's tiers,
 * and the seven layout options read from the singleton with the schema defaults filled. The page
 * arranges library parts and owns its copy (the section kickers and headings the prototype carries,
 * "Odunde" unmarked in display text, ADR 0009) and its layout; the warm treatment lives in the tokens.
 */
import { PUBLIC_SANITY_DATASET, PUBLIC_SANITY_PROJECT_ID } from 'astro:env/client';
import { createImageSet } from '@oy/content/images';
import { galaPageQuery } from '@oy/content/queries';
import PersonCard from '@oy/ui/cards/PersonCard/PersonCard.astro';
import Prose from '@oy/ui/content/Prose/Prose.astro';
import Schedule from '@oy/ui/content/Schedule/Schedule.astro';
import SponsorLevels from '@oy/ui/content/SponsorLevels/SponsorLevels.astro';
import TicketTiers from '@oy/ui/content/TicketTiers/TicketTiers.astro';
import ActionButton from '@oy/ui/core/ActionButton/ActionButton.astro';
import Button from '@oy/ui/core/Button/Button.astro';
import Divider from '@oy/ui/core/Divider/Divider.astro';
import Pending from '@oy/ui/core/Pending/Pending.astro';
import CreditLine from '@oy/ui/media/CreditLine/CreditLine.astro';
import PhotoCarousel from '@oy/ui/media/PhotoCarousel/PhotoCarousel.astro';
import ButtonRow from '@oy/ui/page/ButtonRow/ButtonRow.astro';
import CardGrid from '@oy/ui/page/CardGrid/CardGrid.astro';
import GlanceStrip from '@oy/ui/page/GlanceStrip/GlanceStrip.astro';
import Handoff from '@oy/ui/page/Handoff/Handoff.astro';
import PageHeader from '@oy/ui/page/PageHeader/PageHeader.astro';
import Section from '@oy/ui/page/Section/Section.astro';
import SectionHead from '@oy/ui/page/SectionHead/SectionHead.astro';
import Split from '@oy/ui/page/Split/Split.astro';
import TakePartBand from '@oy/ui/page/TakePartBand/TakePartBand.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { cachePage } from '../lib/cache';
import { STUDIO_BASE_PATH } from '../lib/paths';
import { buildGalaPage } from '../lib/sanity/gala-page';
import { loadQuery } from '../lib/sanity/load-query';

const { data, preview } = await loadQuery(galaPageQuery, {}, { cookies: Astro.cookies });
const imageSet = createImageSet({
  projectId: PUBLIC_SANITY_PROJECT_ID,
  dataset: PUBLIC_SANITY_DATASET,
});
const page = buildGalaPage(data, { imageSet, draft: preview, studioUrl: STUDIO_BASE_PATH });
cachePage(Astro, '/gala', { draft: preview });
---

<SiteLayout title={page.title} description={page.description} root={page.root}>
  <main id="main">
    <PageHeader
      variant="photo"
      kicker={page.header.kicker}
      title={page.header.title}
      titlePending="the page heading"
      line={page.header.line}
      image={page.header.image}
      imagePending="the header photograph"
      imageEdit={page.header.imageEdit}
      actions={page.header.actions}
      facts={page.header.facts}
      dots
      edit={page.edit.treatment}
    />
    <GlanceStrip
      facts={page.glance}
      caption="Everything you need to say yes: the date, the dress, and the price."
    />

    <Section id="evening" labelledby="evening-heading">
      <Split>
        <SectionHead
          kicker={{ yo: 'Alẹ́ náà', en: 'The evening' }}
          title="The evening"
          id="evening-heading"
        />
        {
          page.evening.intro ? (
            <Prose text={page.evening.intro} />
          ) : (
            <p>
              <Pending what={page.evening.introPending} />
            </p>
          )
        }
        {
          page.evening.schedule.shown && (
            <Schedule
              slot="aside"
              items={page.evening.schedule.items}
              pending={page.evening.schedule.pending}
              edit={page.edit.schedule}
            />
          )
        }
      </Split>
    </Section>

    <Divider kind="seam" />

    <Section id="seats" ground="alt" labelledby="seats-heading" data-sanity={page.edit.emphasis}>
      <SectionHead
        kicker={{ yo: 'Ìjókòó', en: 'Seats' }}
        title="Seats and tables"
        intro={page.seats.intro}
        id="seats-heading"
      />
      <TicketTiers
        tiers={page.seats.tiers}
        layout={page.seats.layout}
        emphasis={page.seats.emphasis}
        ticketsUrl={page.seats.ticketsUrl}
        pending={page.seats.pending}
        ticketsPending={page.seats.ticketsPending}
        pricePending={page.seats.pricePending}
        includesPending={page.seats.includesPending}
        edit={page.edit.tiers}
      />
    </Section>

    <Section id="sponsor" labelledby="sponsor-heading">
      <SectionHead
        kicker={{ yo: 'Àtìlẹ́yìn', en: 'Support' }}
        title="Sponsor the Gala"
        intro={page.sponsor.intro}
        id="sponsor-heading"
      />
      <SponsorLevels
        levels={page.sponsor.levels}
        pending={page.sponsor.pending}
        amountPending={page.sponsor.amountPending}
        recognitionPending={page.sponsor.recognitionPending}
      />
      <ButtonRow>
        <ActionButton
          action={{ label: 'Sponsor the Gala', kind: 'enquiry', enquiryKind: 'sponsor' }}
          variant="primary"
        />
        <span class="oy-button-row-note">Four questions, and we send the deck with our impact numbers.</span>
      </ButtonRow>
      <Handoff
        shape="box"
        variant="quiet"
        text="Want the numbers before you commit? The impact page has them, with a source line under each one."
        action={{ label: 'See our impact', kind: 'url', href: '/impact' }}
      />
    </Section>

    {
      page.honorees.shown && (
        <Section id="honorees" ground="alt" labelledby="honorees-heading" data-sanity={page.edit.awards}>
          <SectionHead
            title="Honorees and recognitions"
            intro={page.honorees.intro}
            id="honorees-heading"
          />
          {page.honorees.items.length > 0 ? (
            <CardGrid columns={3}>
              {page.honorees.items.map((person) => (
                <PersonCard person={person} edit={person.edit} />
              ))}
            </CardGrid>
          ) : (
            <Pending variant="line" what={page.honorees.pending} />
          )}
        </Section>
      )
    }

    {
      page.past.shown && (
        <Section id="past" labelledby="past-heading" data-sanity={page.edit.past}>
          <SectionHead
            kicker={{ yo: 'Ọdún tí ó kọjá', en: 'Years past' }}
            title="Past galas"
            intro={page.past.intro}
            id="past-heading"
          />
          <PhotoCarousel
            id="past-carousel"
            labelledby="past-heading"
            slides={page.past.slides}
            pending={page.past.pending}
            edit={page.past.album?.edit}
          />
          {page.past.album && (
            <CreditLine
              credit={page.past.album.credit}
              confirmed={page.past.album.confirmed}
              pending={page.past.album.pending}
            />
          )}
          <ButtonRow>
            <Button variant="secondary" href="/gallery" arrow>
              All gala albums
            </Button>
            <Button variant="quiet" href="/odunde" arrow>
              The other half of our year, Odunde
            </Button>
          </ButtonRow>
        </Section>
      )
    }

    <Section id="take-part" ground="alt" labelledby="take-part-heading" data-sanity={page.edit.labels}>
      <SectionHead
        kicker={{ yo: 'Ẹ dara pọ̀ mọ́ wa', en: 'Join us' }}
        title="Take part"
        intro={page.takePart.intro}
        id="take-part-heading"
      />
      <TakePartBand
        rows={page.takePart.rows}
        labels={page.takePart.labels}
        pending={page.takePart.pending}
        rowPending={page.takePart.rowPending}
      />
    </Section>
  </main>
</SiteLayout>
