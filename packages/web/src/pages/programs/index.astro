---
/**
 * The Programs hub (`10 Programs.dc.html`, ROUTES sections 1, 4 and 5): composed from the one Programs
 * query through `loadQuery`, with the registry's Pending chips for every fact the Studio does not hold
 * and the layout options read from the singleton with the schema defaults filled. The page arranges
 * library parts and owns its copy (the section kickers and headings the prototype carries) and its
 * layout. The prototype's cards section has no heading, so a visually hidden one keeps the headings
 * from skipping a level.
 */
import { PUBLIC_SANITY_DATASET, PUBLIC_SANITY_PROJECT_ID } from 'astro:env/client';
import { createImageSet } from '@oy/content/images';
import { programsPageQuery } from '@oy/content/queries';
import ProgramCard from '@oy/ui/cards/ProgramCard/ProgramCard.astro';
import SubprogramCard from '@oy/ui/cards/SubprogramCard/SubprogramCard.astro';
import Disclosure from '@oy/ui/content/Disclosure/Disclosure.astro';
import FactList from '@oy/ui/content/FactList/FactList.astro';
import Prose from '@oy/ui/content/Prose/Prose.astro';
import Pending from '@oy/ui/core/Pending/Pending.astro';
import PhotoTile from '@oy/ui/media/PhotoTile/PhotoTile.astro';
import CardGrid from '@oy/ui/page/CardGrid/CardGrid.astro';
import PageHeader from '@oy/ui/page/PageHeader/PageHeader.astro';
import Section from '@oy/ui/page/Section/Section.astro';
import SectionHead from '@oy/ui/page/SectionHead/SectionHead.astro';
import Split from '@oy/ui/page/Split/Split.astro';
import TakePartBand from '@oy/ui/page/TakePartBand/TakePartBand.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { cachePage } from '../../lib/cache';
import { STUDIO_BASE_PATH } from '../../lib/paths';
import { loadQuery } from '../../lib/sanity/load-query';
import { buildProgramsPage } from '../../lib/sanity/programs-page';

const { data, preview, error } = await loadQuery(programsPageQuery, {}, { cookies: Astro.cookies });
const imageSet = createImageSet({
  projectId: PUBLIC_SANITY_PROJECT_ID,
  dataset: PUBLIC_SANITY_DATASET,
});
const page = buildProgramsPage(data, { imageSet, draft: preview, studioUrl: STUDIO_BASE_PATH });
cachePage(Astro, '/programs', { draft: preview, failed: Boolean(error) });
---

<SiteLayout title={page.title} description={page.description} root={page.root}>
  <main id="main">
    <PageHeader
      variant={page.header.variant}
      kicker={page.header.kicker}
      title={page.header.title}
      titlePending={page.header.titlePending}
      line={page.header.line}
      actions={page.header.actions}
    />

    <Section id="four" labelledby="programs-heading" data-sanity={page.edit.cards}>
      <h2 class="oy-visually-hidden" id="programs-heading">The programs</h2>
      <CardGrid
        columns={page.cards.columns}
        note="Each card says who it is for and when it runs, so you can find the right one at a glance."
      >
        {
          page.cards.items.map((card) => (
            <ProgramCard
              program={card.program}
              when
              mediaHeight={page.cards.mediaHeight}
              imageEdit={card.imageEdit}
            />
          ))
        }
      </CardGrid>
    </Section>

    {
      page.kids.shown && (
        <Section id="kids" ground="alt" labelledby="kids-heading">
          <Disclosure open={page.kids.open} label={page.kids.title ?? 'Kids & STEM'} edit={page.edit.inline}>
            <SectionHead
              slot="head"
              kicker={{ yo: 'Àwọn ọmọ', en: 'The children' }}
              title={page.kids.title ?? 'Kids & STEM'}
              id="kids-heading"
            />
            {page.kids.blurb && <Prose text={page.kids.blurb} />}
            {page.kids.subprograms.length > 0 && (
              <CardGrid columns={2}>
                {page.kids.subprograms.map((subprogram) => (
                  <SubprogramCard subprogram={subprogram} imageEdit={subprogram.imageEdit} />
                ))}
              </CardGrid>
            )}
          </Disclosure>
        </Section>
      )
    }

    {
      page.exchange.shown && (
        <Section id="exchange" labelledby="exchange-heading">
          <Disclosure
            open={page.exchange.open}
            label={page.exchange.title ?? 'Cultural Exchange'}
            edit={page.edit.inline}
          >
            <SectionHead
              slot="head"
              kicker={{ yo: 'Ìpàdé àṣà', en: 'Meeting of cultures' }}
              title={page.exchange.title ?? 'Cultural Exchange'}
              id="exchange-heading"
            />
            <Split>
              {page.exchange.blurb ? (
                <Prose text={page.exchange.blurb} />
              ) : (
                <p>
                  <Pending what={page.exchange.blurbPending} />
                </p>
              )}
              <FactList facts={page.exchange.facts} columns={1} />
              <PhotoTile
                slot="aside"
                shape="figure"
                image={page.exchange.image}
                what={page.exchange.imagePending}
                sizes="(min-width: 1100px) 480px, (min-width: 900px) 45vw, 100vw"
                edit={page.exchange.imageEdit}
              />
            </Split>
          </Disclosure>
        </Section>
      )
    }

    <Section id="take-part" labelledby="take-part-heading">
      <SectionHead
        kicker={{ yo: 'Ẹ dara pọ̀ mọ́ wa', en: 'Join us' }}
        title="Take part"
        intro={page.takePart.intro}
        id="take-part-heading"
      />
      <TakePartBand
        rows={page.takePart.rows}
        labels={page.takePart.labels}
        pending={page.takePart.pending}
        rowPending={page.takePart.rowPending}
      />
    </Section>
  </main>
</SiteLayout>
