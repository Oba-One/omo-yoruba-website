---
/**
 * The homepage (`02 Homepage.dc.html`, ROUTES sections 1, 4 and 5): composed from the one
 * homepage query through `loadQuery`, with the lead edition from the season rule and the seven
 * layout options read from the singleton and filled with the schema defaults. The page arranges
 * library parts and owns its copy (the section kickers and headings the prototype carries) and
 * its layout; every fact comes from the Studio or renders Pending. The forms seam opens from the
 * real doors: the member and partner doors below, the footer's volunteer, contact and donate
 * links and the nav's Donate.
 */
import { PUBLIC_SANITY_DATASET, PUBLIC_SANITY_PROJECT_ID } from 'astro:env/client';
import { createImageSet } from '@oy/content/images';
import { pendingWhat } from '@oy/content/pending';
import { homepageQuery } from '@oy/content/queries';
import EventBand from '@oy/ui/bands/EventBand/EventBand.astro';
import DoorCard from '@oy/ui/cards/DoorCard/DoorCard.astro';
import NewsCard from '@oy/ui/cards/NewsCard/NewsCard.astro';
import PathRow from '@oy/ui/cards/PathRow/PathRow.astro';
import ProgramCard from '@oy/ui/cards/ProgramCard/ProgramCard.astro';
import PullQuote from '@oy/ui/cards/PullQuote/PullQuote.astro';
import PathRows from '@oy/ui/content/PathRows/PathRows.astro';
import ProverbLine from '@oy/ui/content/ProverbLine/ProverbLine.astro';
import PhotoMosaic from '@oy/ui/media/PhotoMosaic/PhotoMosaic.astro';
import CardGrid from '@oy/ui/page/CardGrid/CardGrid.astro';
import Handoff from '@oy/ui/page/Handoff/Handoff.astro';
import Hero from '@oy/ui/page/Hero/Hero.astro';
import Section from '@oy/ui/page/Section/Section.astro';
import SectionHead from '@oy/ui/page/SectionHead/SectionHead.astro';
import StatStrip from '@oy/ui/page/StatStrip/StatStrip.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { cachePage } from '../lib/cache';
import { STUDIO_BASE_PATH } from '../lib/paths';
import { buildHomepage } from '../lib/sanity/homepage';
import { loadQuery } from '../lib/sanity/load-query';

const { data, preview, error } = await loadQuery(homepageQuery, {}, { cookies: Astro.cookies });
const imageSet = createImageSet({
  projectId: PUBLIC_SANITY_PROJECT_ID,
  dataset: PUBLIC_SANITY_DATASET,
});
const home = buildHomepage(data, { imageSet, draft: preview, studioUrl: STUDIO_BASE_PATH });
cachePage(Astro, '/', { draft: preview, failed: Boolean(error) });
---

<SiteLayout
  title={home.title}
  description={home.description}
  root={home.root}
  newsletter={home.layout.newsletter}
  newsletterEdit={home.edit.newsletter}
>
  <main id="main">
    <Hero
      image={home.hero.image}
      imageEdit={home.hero.imageEdit}
      edit={home.hero.edit}
      kicker={home.hero.kicker}
      title={home.hero.title}
      emphasis={home.hero.emphasis}
      sub={home.hero.sub}
      blessing={home.hero.blessing}
      primary={home.hero.primary}
      secondary={home.hero.secondary}
      motion={home.hero.motion}
    />
    <StatStrip stats={home.stats} id="impact" />
    <EventBand event={home.lead.event} kind={home.lead.kind} edit={home.edit.season} id="lead-event" />

    <Section id="programs" labelledby="programs-heading" data-sanity={home.edit.highlight}>
      <SectionHead
        kicker={{ yo: 'Ohun tí a ń ṣe', en: 'What we do' }}
        title="Our programs"
        intro={home.programsIntro}
        link={{ label: 'All programs', href: '/programs' }}
        id="programs-heading"
      />
      <CardGrid columns={3}>
        {home.programs.map(({ program, imageEdit }) => (
          <ProgramCard program={program} imageEdit={imageEdit} />
        ))}
      </CardGrid>
    </Section>

    <Section id="voices" ground="paper" texture="batik" labelledby="voices-heading" data-sanity={home.edit.pattern}>
      <SectionHead
        kicker={{ yo: 'Àwọn ohùn wa', en: 'Our voices' }}
        title="Member voices"
        intro={home.voicesIntro}
        id="voices-heading"
      />
      <CardGrid columns={3}>
        {home.voices.map(({ testimonial, placeholder }) => (
          <PullQuote testimonial={testimonial} placeholder={placeholder} />
        ))}
      </CardGrid>
      <ProverbLine yo={home.proverb?.yo} en={home.proverb?.en} />
    </Section>

    <Section id="news" labelledby="news-heading">
      <SectionHead
        kicker={{ en: 'Stay close' }}
        title="News & events"
        intro={home.newsIntro}
        id="news-heading"
      />
      <CardGrid columns={3}>
        {home.news.map(({ post, href }) => (
          <NewsCard post={post} href={href} />
        ))}
      </CardGrid>
    </Section>

    <Section id="gallery" ground="alt" labelledby="gallery-heading">
      <SectionHead
        kicker={{ yo: 'Ìgbésí ayé wa', en: 'Our life together' }}
        title="A year in the life"
        id="gallery-heading"
      />
      <PhotoMosaic tiles={home.tiles} count={home.layout.gallery} edit={home.edit.gallery} />
      <Handoff
        action={{ label: 'Open the photo gallery', kind: 'url', href: '/gallery' }}
        text="Odunde, the Gala, and the language lessons, year by year."
      />
    </Section>

    <Section id="get-involved" labelledby="involved-heading" data-sanity={home.edit.involved}>
      <SectionHead
        kicker={{ yo: 'Ẹ dara pọ̀ mọ́ wa', en: 'Join us' }}
        title={home.raiseYourHand.title}
        intro={home.raiseYourHand.blurb}
        pending={pendingWhat('homepage', 'raiseYourHand.title')}
        id="involved-heading"
      />
      {
        home.layout.involved === 'rows' ? (
          <PathRows>
            {home.raiseYourHand.doors.map(({ door }, index) => (
              <PathRow door={door} primary={index === 0} />
            ))}
          </PathRows>
        ) : (
          <CardGrid columns={2}>
            {home.raiseYourHand.doors.map(({ door, imageEdit }, index) => (
              <DoorCard door={door} imageEdit={imageEdit} primary={index === 0} />
            ))}
          </CardGrid>
        )
      }
    </Section>
  </main>
</SiteLayout>

