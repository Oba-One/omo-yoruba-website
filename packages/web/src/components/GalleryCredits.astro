---
/**
 * Photography credit and permissions, the section `/gallery` and every album page close with (`18 Photo
 * Gallery.dc.html`, spec Q13 of Phase 8): the prototype's split on the alternate ground, the heading and its
 * lead on the left, the three rows and a quiet "Send a message" on the right. Arranged from library parts with
 * no styling of its own; the rows come from `galleryCredits`.
 */
import FactList from '@oy/ui/content/FactList/FactList.astro';
import ActionButton from '@oy/ui/core/ActionButton/ActionButton.astro';
import ButtonRow from '@oy/ui/page/ButtonRow/ButtonRow.astro';
import Section from '@oy/ui/page/Section/Section.astro';
import SectionHead from '@oy/ui/page/SectionHead/SectionHead.astro';
import Split from '@oy/ui/page/Split/Split.astro';
import type { GalleryCreditsView } from '../lib/sanity/gallery-credits';

interface Props {
  credits: GalleryCreditsView;
}

const { credits } = Astro.props;
---

<Section id="credit" ground="alt" labelledby="credit-heading">
  <Split>
    <SectionHead title={credits.title} intro={credits.lead} id="credit-heading" />
    <Fragment slot="aside">
      <FactList facts={credits.rows} columns={1} />
      <ButtonRow>
        <ActionButton action={credits.action} variant="quiet" arrow />
      </ButtonRow>
    </Fragment>
  </Split>
</Section>
